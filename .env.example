# ============================================================
# MOVDI · ops — plantilla de variables de entorno
# Copia este archivo a .env.local y llena los valores.
# .env.local está en .gitignore y NUNCA se commitea.
# ============================================================

# Público — puede ir al navegador (prefijo NEXT_PUBLIC_)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SECRETO — solo servidor. JAMÁS con prefijo NEXT_PUBLIC_, jamás en código cliente.
# Generar en: Supabase Dashboard → Project Settings → API Keys → "secret keys"
SUPABASE_SERVICE_ROLE_KEY=

# SECRETO — verificación adicional del panel RH (se valida en servidor, fase RH)
RH_ACCESS_SECRET=
